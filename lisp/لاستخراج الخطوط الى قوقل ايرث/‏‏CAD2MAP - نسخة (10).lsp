(defun c:CADEARTH () (Main-CAD2EARTH))
(defun c:CAD2MAP () (Main-CAD2EARTH))
(defun c:CAD2EARTH () (Main-CAD2EARTH))

(princ "\n[✓] تم تحميل CADEARTH PRO بنجاح! الاختصارات: CE أو CADEARTH")
(princ)