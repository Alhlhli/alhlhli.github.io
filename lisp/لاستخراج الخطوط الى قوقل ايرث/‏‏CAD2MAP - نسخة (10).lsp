;; دالة الظل الرياضية
(defun _tan (ang) (/ (sin ang) (cos ang)))

;; دالة تجزئة نصية لتوليد ألوان ثابتة للطبقات
(defun Str-Hash (s / i sum)
  (setq sum 0 i 0)
  (while (< i (strlen s))
    (setq sum (+ sum (ascii (substr s (1+ i) 1))))
    (setq i (1+ i))
  )
  sum
)

;; لون KML ثابت حسب اسم الطبقة
(defun Layer-Color-KML (lyr / palette h)
  (setq palette '("ff3b82f6" "ff10b981" "ffef4444" "fff59e0b"
                  "ff8b5cf6" "ffec4899" "ff14b8a6" "ffef8354"))
  (setq h (rem (Str-Hash (if lyr lyr "0")) (length palette)))
  (nth h palette)
)

;; فحص إمكانية الكتابة في المجلد لتفادي أخطاء الصلاحيات
(defun Is-Writable-Dir (dir / testFile f res)
  (setq res nil)
  (if (and dir (/= dir ""))
    (progn
      (setq testFile (strcat dir "chk_perm_" (rtos (getvar "CDATE") 2 6) ".tmp"))
      (setq f (open testFile "w"))
      (if f
        (progn
          (close f)
          (vl-file-delete testFile)
          (setq res T)
        )
      )
    )
  )
  res
)

;; تحويل إحداثيات UTM إلى Lat/Lon WGS84 بدقة هندسية عالية
(defun UTM->WGS84 (east north zone south / a f e2 e e1 rad2deg deg2rad M mu J1 J2 J3 J4 phi1 C1 T1 N1 R1 D lat lon)
  (setq a 6378137.0
        f (/ 1.0 298.257223563)
        e2 (* f (- 2.0 f))
        e (sqrt e2)
        e1 (/ (- 1.0 (sqrt (- 1.0 e2))) (+ 1.0 (sqrt (- 1.0 e2))))
        rad2deg (/ 180.0 pi)
        deg2rad (/ pi 180.0))

  (setq east (- (float east) 500000.0))
  (if (and south (or (eq south T) (= south "1") (= south 1)))
    (setq north (- (float north) 10000000.0))
    (setq north (float north))
  )
  (setq M (/ north 0.9996))
  (setq mu (/ M (* a (- 1.0 (/ e2 4.0) (/ (* 3.0 e2 e2) 64.0) (/ (* 5.0 (expt e2 3)) 256.0)))))

  (setq J1 (- (/ (* 3.0 e1) 2.0) (/ (* 27.0 (expt e1 3)) 32.0)))
  (setq J2 (- (/ (* 21.0 (* e1 e1)) 16.0) (/ (* 55.0 (expt e1 4)) 32.0)))
  (setq J3 (/ (* 151.0 (expt e1 3)) 96.0))
  (setq J4 (/ (* 1097.0 (expt e1 4)) 512.0))

  (setq phi1 (+ mu (* J1 (sin (* 2.0 mu))) (* J2 (sin (* 4.0 mu))) (* J3 (sin (* 6.0 mu))) (* J4 (sin (* 8.0 mu)))))

  (setq C1 (* (/ e2 (- 1.0 e2)) (* (cos phi1) (cos phi1))))
  (setq T1 (* (_tan phi1) (_tan phi1)))
  (setq N1 (/ a (sqrt (- 1.0 (* e2 (sin phi1) (sin phi1))))))
  (setq R1 (/ (* a (- 1.0 e2)) (expt (- 1.0 (* e2 (sin phi1) (sin phi1))) 1.5)))
  (setq D (/ east (* N1 0.9996)))

  (setq lat (- phi1
               (* (/ (* N1 (_tan phi1)) R1)
                  (- (/ (* D D) 2.0)
                     (/ (* (+ 5.0 (* 3.0 T1) (* 10.0 C1) (* -4.0 C1 C1)) (expt D 4)) 24.0)
                     (/ (* (+ 61.0 (* 90.0 T1) (* 298.0 C1) (* 45.0 T1 T1)) (expt D 6)) 720.0)))))

  (setq lon (+ (/ (- D
                     (/ (* (+ 1.0 (* 2.0 T1) C1) (expt D 3)) 6.0)
                     (/ (* (+ 5.0 (* 28.0 T1) (* 24.0 T1 T1)) (expt D 5)) 120.0))
                  (cos phi1))
               (* (- (* (float zone) 6.0) 183.0) deg2rad)))

  (list (* lon rad2deg) (* lat rad2deg))
)

;; حفظ ملفات KML / GeoJSON بترميز UTF-8
(defun Write-UTF8 (filePath content / stream f success)
  (setq success nil)
  (if (not (vl-catch-all-error-p
             (vl-catch-all-apply
               '(lambda ()
                  (setq stream (vlax-create-object "ADODB.Stream"))
                  (vlax-put-property stream 'Type 2)
                  (vlax-put-property stream 'Charset "utf-8")
                  (vlax-invoke-method stream 'Open)
                  (vlax-invoke-method stream 'WriteText content)
                  (vlax-invoke-method stream 'SaveToFile filePath 2)
                  (vlax-invoke-method stream 'Close)
                  (vlax-release-object stream)
                  (setq success T)
                ))))
    (setq success T)
  )
  (if (not success)
    (if (setq f (open filePath "w"))
      (progn
        (write-line content f)
        (close f)
        (setq success T)
      )
    )
  )
  success
)

;; تحويل القوس ARC إلى سلسلة نقاط
(defun Tessellate-Arc (ent / edata center radius startAng endAng elev seg pts ang i)
  (setq edata (entget ent)
        center (cdr (assoc 10 edata))
        radius (cdr (assoc 40 edata))
        startAng (cdr (assoc 50 edata))
        endAng (cdr (assoc 51 edata))
        elev (caddr center))
  (if (null elev) (setq elev 0.0))
  (if (< endAng startAng) (setq endAng (+ endAng (* 2.0 pi))))
  (setq seg 24 pts '() i 0)
  (while (<= i seg)
    (setq ang (+ startAng (* (/ (- endAng startAng) seg) i)))
    (setq pts (cons (list (+ (car center) (* radius (cos ang)))
                          (+ (cadr center) (* radius (sin ang)))
                          elev) pts))
    (setq i (1+ i))
  )
  (reverse pts)
)

;; تحويل الدائرة CIRCLE إلى مضلع نقاط مغلق
(defun Tessellate-Circle (ent / edata center radius elev seg pts ang i)
  (setq edata (entget ent)
        center (cdr (assoc 10 edata))
        radius (cdr (assoc 40 edata))
        elev (caddr center))
  (if (null elev) (setq elev 0.0))
  (setq seg 36 pts '() i 0)
  (while (<= i seg)
    (setq ang (* (/ (* 2.0 pi) seg) i))
    (setq pts (cons (list (+ (car center) (* radius (cos ang)))
                          (+ (cadr center) (* radius (sin ang)))
                          elev) pts))
    (setq i (1+ i))
  )
  (reverse pts)
)

;; حساب الأطوال ثنائية الأبعاد بطريقة آمنة
(defun Calc-Length (pts / len i p1 p2)
  (setq len 0.0 i 0)
  (if (and pts (listp pts) (> (length pts) 1))
    (while (< (1+ i) (length pts))
      (setq p1 (nth i pts) p2 (nth (1+ i) pts))
      (if (and p1 p2 (numberp (car p1)) (numberp (car p2)) (numberp (cadr p1)) (numberp (cadr p2)))
        (setq len (+ len (sqrt (+ (expt (- (car p2) (car p1)) 2) (expt (- (cadr p2) (cadr p1)) 2))))))
      (setq i (1+ i))
    )
  )
  len
)

;; حساب مساحة المضلع (Shoelace Formula) بطريقة آمنة
(defun Calc-Area (pts / area i n p1 p2)
  (setq area 0.0)
  (if (and pts (listp pts) (>= (length pts) 3))
    (progn
      (setq n (length pts) i 0)
      (while (< i (1- n))
        (setq p1 (nth i pts) p2 (nth (1+ i) pts))
        (if (and p1 p2 (numberp (car p1)) (numberp (car p2)) (numberp (cadr p1)) (numberp (cadr p2)))
          (setq area (+ area (- (* (car p1) (cadr p2)) (* (car p2) (cadr p1))))))
        (setq i (1+ i))
      )
      (setq area (abs (/ area 2.0)))
    )
  )
  area
)

;; استخراج العناصر الهندسية مع عزل الأخطاء
(defun Extract-CAD-Geometry (ss optClose / i n ent edata entType lyr isClosed pts elevG flag70 sub p1 p2 pt res lenVal areaVal)
  (setq res '() i 0 n (sslength ss))
  (while (< i n)
    (setq ent (ssname ss i)
          edata (entget ent)
          entType (cdr (assoc 0 edata))
          lyr (cdr (assoc 8 edata))
          isClosed nil
          pts '())
    (cond
      ((= entType "POINT")
       (setq pt (cdr (assoc 10 edata)))
       (if pt (setq pts (list (list (car pt) (cadr pt) (if (caddr pt) (caddr pt) 0.0))))))
      
      ((= entType "LINE")
       (setq p1 (cdr (assoc 10 edata)) p2 (cdr (assoc 11 edata)))
       (if (and p1 p2)
         (setq pts (list (list (car p1) (cadr p1) (if (caddr p1) (caddr p1) 0.0))
                         (list (car p2) (cadr p2) (if (caddr p2) (caddr p2) 0.0))))))
      
      ((= entType "ARC")
       (setq pts (Tessellate-Arc ent)))
      
      ((= entType "CIRCLE")
       (setq pts (Tessellate-Circle ent) isClosed T))
      
      ((= entType "LWPOLYLINE")
       (setq elevG (cdr (assoc 38 edata)))
       (if (null elevG) (setq elevG 0.0))
       (setq flag70 (cdr (assoc 70 edata)))
       (if (and flag70 (= (logand flag70 1) 1)) (setq isClosed T))
       (foreach item edata
         (if (= (car item) 10)
           (setq pts (cons (list (cadr item) (caddr item) elevG) pts))))
       (setq pts (reverse pts))
       (if (and (or isClosed (= optClose "1") (eq optClose T)) (> (length pts) 2))
         (setq pts (append pts (list (car pts))) isClosed T)))
      
      ((= entType "POLYLINE")
       (setq flag70 (cdr (assoc 70 edata)))
       (if (and flag70 (= (logand flag70 1) 1)) (setq isClosed T))
       (setq sub (entnext ent))
       (while (and sub (/= (cdr (assoc 0 (entget sub))) "SEQEND"))
         (if (= (cdr (assoc 0 (entget sub))) "VERTEX")
           (progn
             (setq pt (cdr (assoc 10 (entget sub))))
             (setq pts (cons (list (car pt) (cadr pt) (if (caddr pt) (caddr pt) 0.0)) pts))))
         (setq sub (entnext sub)))
       (setq pts (reverse pts))
       (if (and (or isClosed (= optClose "1") (eq optClose T)) (> (length pts) 2))
         (setq pts (append pts (list (car pts))) isClosed T)))
    )
    
    (if (and pts (> (length pts) 0))
      (progn
        (setq lenVal (Calc-Length pts))
        (setq areaVal (if isClosed (Calc-Area pts) 0.0))
        (setq res (cons (list (cons "type" entType)
                              (cons "layer" lyr)
                              (cons "closed" (if isClosed 1 0))
                              (cons "pts" pts)
                              (cons "length" (if (numberp lenVal) lenVal 0.0))
                              (cons "area" (if (numberp areaVal) areaVal 0.0))
                        ) res))
      )
    )
    (setq i (1+ i))
  )
  (reverse res)
)

;; بناء ملف KML
(defun Build-KML (data zone south dec / str item type lyr isCls pts pStr wgs col lenV areaV desc)
  (setq str (strcat "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n"
                    "<kml xmlns=\"http://www.opengis.net/kml/2.2\">\n"
                    "<Document>\n<name>AutoCAD Export - Zone " (rtos zone 2 0) (if south "S" "N") "</name>\n"))
  (foreach item data
    (setq type (cdr (assoc "type" item))
          lyr (cdr (assoc "layer" item))
          isCls (cdr (assoc "closed" item))
          pts (cdr (assoc "pts" item))
          lenV (cdr (assoc "length" item))
          areaV (cdr (assoc "area" item))
          col (Layer-Color-KML lyr))
    
    (if (not (numberp lenV)) (setq lenV 0.0))
    (if (not (numberp areaV)) (setq areaV 0.0))
    
    (setq desc (strcat "Layer: " (if lyr lyr "0")
                       (if (> lenV 0.0) (strcat " | Length: " (rtos lenV 2 2) " m") "")
                       (if (> areaV 0.0) (strcat " | Area: " (rtos areaV 2 2) " m2") "")))
    (setq str (strcat str "<Placemark>\n<name>" type " (" (if lyr lyr "0") ")</name>\n<description>" desc "</description>\n"
                      "<Style><LineStyle><color>" col "</color><width>3</width></LineStyle>"
                      "<PolyStyle><color>66" (substr col 3) "</color></PolyStyle></Style>\n"))
    (cond
      ((= type "POINT")
       (setq wgs (UTM->WGS84 (caar pts) (cadar pts) zone south))
       (setq str (strcat str "<Point><coordinates>" (rtos (car wgs) 2 7) "," (rtos (cadr wgs) 2 7) "," (rtos (if (caddar pts) (caddar pts) 0.0) 2 dec) "</coordinates></Point>\n")))
      
      ((= isCls 1)
       (setq pStr "")
       (foreach pt pts
         (setq wgs (UTM->WGS84 (car pt) (cadr pt) zone south))
         (setq pStr (strcat pStr (rtos (car wgs) 2 7) "," (rtos (cadr wgs) 2 7) "," (rtos (if (caddr pt) (caddr pt) 0.0) 2 dec) " ")))
       (setq str (strcat str "<Polygon><outerBoundaryIs><LinearRing><coordinates>" pStr "</coordinates></LinearRing></outerBoundaryIs></Polygon>\n")))
      
      (T
       (setq pStr "")
       (foreach pt pts
         (setq wgs (UTM->WGS84 (car pt) (cadr pt) zone south))
         (setq pStr (strcat pStr (rtos (car wgs) 2 7) "," (rtos (cadr wgs) 2 7) "," (rtos (if (caddr pt) (caddr pt) 0.0) 2 dec) " ")))
       (setq str (strcat str "<LineString><tessellate>1</tessellate><coordinates>" pStr "</coordinates></LineString>\n")))
    )
    (setq str (strcat str "</Placemark>\n"))
  )
  (strcat str "</Document>\n</kml>")
)

;; بناء ملف GeoJSON
(defun Build-GeoJSON (data zone south dec / str item type lyr isCls pts pStr wgs first geoType coordStr lenV areaV)
  (setq str "{\n  \"type\": \"FeatureCollection\",\n  \"features\": [\n")
  (setq first T)
  (foreach item data
    (setq type (cdr (assoc "type" item))
          lyr (cdr (assoc "layer" item))
          isCls (cdr (assoc "closed" item))
          pts (cdr (assoc "pts" item))
          lenV (cdr (assoc "length" item))
          areaV (cdr (assoc "area" item)))
    (if (not (numberp lenV)) (setq lenV 0.0))
    (if (not (numberp areaV)) (setq areaV 0.0))
    (if (not first) (setq str (strcat str ",\n")))
    (setq first nil)
    (cond
      ((= type "POINT")
       (setq wgs (UTM->WGS84 (caar pts) (cadar pts) zone south))
       (setq geoType "Point")
       (setq coordStr (strcat "[" (rtos (car wgs) 2 7) "," (rtos (cadr wgs) 2 7) "," (rtos (if (caddar pts) (caddar pts) 0.0) 2 dec) "]")))
      
      ((= isCls 1)
       (setq geoType "Polygon")
       (setq pStr "")
       (foreach pt pts
         (setq wgs (UTM->WGS84 (car pt) (cadr pt) zone south))
         (setq pStr (strcat pStr "[" (rtos (car wgs) 2 7) "," (rtos (cadr wgs) 2 7) "," (rtos (if (caddr pt) (caddr pt) 0.0) 2 dec) "],")))
       (if (= (substr pStr (strlen pStr)) ",") (setq pStr (substr pStr 1 (1- (strlen pStr)))))
       (setq coordStr (strcat "[[" pStr "]]")))
      
      (T
       (setq geoType "LineString")
       (setq pStr "")
       (foreach pt pts
         (setq wgs (UTM->WGS84 (car pt) (cadr pt) zone south))
         (setq pStr (strcat pStr "[" (rtos (car wgs) 2 7) "," (rtos (cadr wgs) 2 7) "," (rtos (if (caddr pt) (caddr pt) 0.0) 2 dec) "],")))
       (if (= (substr pStr (strlen pStr)) ",") (setq pStr (substr pStr 1 (1- (strlen pStr)))))
       (setq coordStr (strcat "[" pStr "]")))
    )
    (setq str (strcat str "    {\"type\": \"Feature\", \"properties\": {\"layer\": \"" (if lyr lyr "0") "\", \"entType\": \"" type
                          "\", \"length_m\": " (rtos lenV 2 2) ", \"area_m2\": " (rtos areaV 2 2)
                          "}, \"geometry\": {\"type\": \"" geoType "\", \"coordinates\": " coordStr "}}"))
  )
  (strcat str "\n  ]\n}")
)

;; كتابة تقرير HTML بنظام التدفق السطري (Stream Output لتفادي حدود النصوص الطويلة)
(defun Write-HTML-Report (filePath data utmZone south dec / stream f useStream item type lyr isCls pts ptStr lenV areaV)
